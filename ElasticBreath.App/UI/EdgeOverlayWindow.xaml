<Window x:Class="ElasticBreath.App.UI.EdgeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        IsHitTestVisible="False"
        ShowActivated="False"
        Focusable="False">
    <Grid>
        <Rectangle x:Name="TopGlow" VerticalAlignment="Top" Height="80" IsHitTestVisible="False"/>
        <Rectangle x:Name="BottomGlow" VerticalAlignment="Bottom" Height="80" IsHitTestVisible="False"/>
        <Rectangle x:Name="LeftGlow" HorizontalAlignment="Left" Width="80" IsHitTestVisible="False"/>
        <Rectangle x:Name="RightGlow" HorizontalAlignment="Right" Width="80" IsHitTestVisible="False"/>

        <Border x:Name="TopProgressHost"
                Width="360"
                Height="10"
                Background="#30101010"
                CornerRadius="5"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                Visibility="Collapsed">
            <Border x:Name="TopProgressFill"
                    Height="10"
                    Width="0"
                    HorizontalAlignment="Left"
                    CornerRadius="5"
                    Background="#FF35BE5A"/>
        </Border>
    </Grid>
</Window>
