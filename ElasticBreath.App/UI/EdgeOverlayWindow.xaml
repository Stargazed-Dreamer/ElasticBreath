<Window x:Class="ElasticBreath.App.UI.EdgeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        IsHitTestVisible="False"
        ShowActivated="False"
        Focusable="False"
        Width="0" Height="0">
    <!--
        此窗口仅用于获取 HWND，实际渲染由 UpdateLayeredWindow 完成。
        WPF 自身的视觉树不包含任何内容，完全绕过 WPF 渲染管线。
    -->
</Window>
