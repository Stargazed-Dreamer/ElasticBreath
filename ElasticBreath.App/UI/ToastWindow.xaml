<Window x:Class="ElasticBreath.App.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        Height="62"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        IsHitTestVisible="False"
        Focusable="False">
    <Border Background="#EE1D1D1D"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8">
        <TextBlock x:Name="ToastText"
                   Foreground="White"
                   FontSize="13"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
    </Border>
</Window>
