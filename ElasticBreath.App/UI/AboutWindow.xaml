<Window x:Class="ElasticBreath.App.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        Height="460"
        MinWidth="440"
        MinHeight="420"
        Icon="/Resource/icon.ico"
        Background="#F6FAF8"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image x:Name="AppIcon"
                   Width="56"
                   Height="56"
                   Margin="0,0,14,0"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AppNameText"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#FF1C4C35"/>
                <TextBlock x:Name="VersionText"
                           Margin="0,4,0,0"
                           FontSize="13"
                           Foreground="#FF4A7160"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,14,0,14"
                Padding="14"
                Background="#FFEEF7F2"
                BorderBrush="#FFD1E8DC"
                BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="AuthorRow" Margin="0,0,0,10">
                        <TextBlock x:Name="AuthorLabel"
                                   FontSize="12"
                                   Foreground="#FF577A6A"/>
                        <TextBlock x:Name="AuthorValue"
                                   Margin="0,2,0,0"
                                   FontSize="14"
                                   Foreground="#FF1E3F30"/>
                    </StackPanel>

                    <StackPanel x:Name="RepoRow" Margin="0,0,0,10">
                        <TextBlock x:Name="RepoLabel"
                                   FontSize="12"
                                   Foreground="#FF577A6A"/>
                        <!-- 复制地址按钮放在链接下一行，避免 URL 较长时与按钮并排溢出。 -->
                        <StackPanel Margin="0,2,0,0">
                            <TextBlock FontSize="14" TextWrapping="Wrap">
                                <Hyperlink x:Name="RepoLink"
                                           RequestNavigate="RepoLink_RequestNavigate"
                                           Foreground="#FF1F6FA8"
                                           TextDecorations="Underline"/>
                            </TextBlock>
                            <Button x:Name="CopyRepoButton"
                                    Margin="0,6,0,0"
                                    Padding="8,2"
                                    Height="26"
                                    FontSize="11"
                                    HorizontalAlignment="Left"
                                    Click="CopyRepoButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="LicenseRow" Margin="0,0,0,10">
                        <TextBlock x:Name="LicenseLabel"
                                   FontSize="12"
                                   Foreground="#FF577A6A"/>
                        <TextBlock x:Name="LicenseValue"
                                   Margin="0,2,0,0"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Foreground="#FF1E3F30"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyVersionButton"
                    Width="130"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="CopyVersionButton_Click"/>
            <Button x:Name="OpenCrashLogButton"
                    Width="150"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="OpenCrashLogButton_Click"/>
            <Button x:Name="CloseButton"
                    Width="100"
                    Height="34"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
