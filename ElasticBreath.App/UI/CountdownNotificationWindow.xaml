<Window x:Class="ElasticBreath.App.UI.CountdownNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="420"
        Height="84">
    <Border Background="#F01E1E1E"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="MessageText"
                       Foreground="White"
                       FontSize="14"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="CountdownText"
                       Grid.Row="1"
                       Foreground="#FFD0D0D0"
                       Margin="0,8,0,0"
                       FontSize="12"/>
        </Grid>
    </Border>
</Window>
