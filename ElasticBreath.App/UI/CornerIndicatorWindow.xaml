<Window x:Class="ElasticBreath.App.UI.CornerIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        IsHitTestVisible="False"
        ShowActivated="False"
        Focusable="False"
        Width="64"
        Height="64"
        Left="-100"
        Top="-100">
    <!--
        左上角角落触发的视觉指示：圆心位于屏幕左上角 (0,0)，
        因此用户只能看到右下角的四分之一。窗口置顶、点击穿透、不抢焦点。
    -->
    <Canvas Width="64" Height="64" ClipToBounds="False">
        <Ellipse x:Name="Circle"
                 Canvas.Left="-20"
                 Canvas.Top="-20"
                 Width="40"
                 Height="40"
                 RenderTransformOrigin="0.5,0.5"
                 Opacity="0">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="CircleScale" ScaleX="0" ScaleY="0"/>
            </Ellipse.RenderTransform>
        </Ellipse>
    </Canvas>
</Window>
