<Window x:Class="ElasticBreath.App.UI.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620"
        Height="470"
        MinWidth="560"
        MinHeight="420"
        Icon="/Resource/icon.ico"
        Background="#F6FAF8"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#FF1C4C35"/>
        <Border Grid.Row="1"
                Margin="0,14,0,14"
                Padding="14"
                Background="#FFEEF7F2"
                BorderBrush="#FFD1E8DC"
                BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="BodyText"
                           TextWrapping="Wrap"
                           LineHeight="24"
                           Foreground="#FF1E3F30"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                x:Name="CloseButton"
                Width="100"
                Height="34"
                HorizontalAlignment="Right"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
