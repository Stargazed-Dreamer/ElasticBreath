<Window x:Class="ElasticBreath.App.UI.CornerRingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="44"
        Height="44"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Canvas Width="44" Height="44" ClipToBounds="True">
        <!-- 轨道：半透明黑色，提供浅色背景下的对比 -->
        <Ellipse Canvas.Left="6" Canvas.Top="6" Width="32" Height="32"
                 Stroke="#99000000" StrokeThickness="3" Fill="Transparent"/>
        <!-- 进度弧：白色，深色背景下可见 -->
        <Path x:Name="ProgressArc"
              Canvas.Left="6" Canvas.Top="6"
              Stroke="#FFFFFFFF" StrokeThickness="3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent"/>
    </Canvas>
</Window>
